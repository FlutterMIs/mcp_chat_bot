OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-4.1-mini
DATABASE_URL=sqlite:///demo.db
OPENROUTER_STT_MODEL=google/gemini-2.5-flash

# ---------- WhatsApp (OpenWA) ----------
OPENWA_BASE_URL=https://w.ashveratech.com
# Dashboard → API Keys. Operator role is enough (send messages, read media, convert voice).
OPENWA_API_KEY=
# Session name from the dashboard (e.g. new-testing) or its UUID; the name is resolved to the UUID at startup.
OPENWA_SESSION=new-testing
# Same value you type in the webhook's "secret" (16-255 chars). Webhooks without a valid signature are rejected.
OPENWA_WEBHOOK_SECRET=
# Who the bot answers: comma-separated numbers with country code (919999900001), or * for everyone.
# Empty = nobody. The session is a real WhatsApp account, so keep this tight.
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_ALLOW_GROUPS=false
# Data WhatsApp users can ask about (the web app's sidebar sources live only in the browser session).
WHATSAPP_GOOGLE_SHEET_URL=
WHATSAPP_DATA_FILES=
WHATSAPP_SOURCE_REFRESH_SECONDS=300
# SQL database for WhatsApp users (SQLAlchemy URL, read with SELECT only). Set it here, never send it in a chat.
# e.g. postgresql://readonly_user:pass@host:5432/erp   mysql+pymysql://user:pass@host/erp   sqlite:///erp.db
WHATSAPP_DATABASE_URL=
# Users may send a Google Sheet / website link in the chat to add it as a source for that chat.
WHATSAPP_ALLOW_CHAT_LINKS=true
# Send a chart image automatically for grouped / month-wise results (not only when asked).
WHATSAPP_AUTO_CHART=true
# Public https base of this server. Empty = learnt from the webhook's Host header (works with cloudflared).
# Used for chart/CSV links when OpenWA can't send images/documents; links expire after 24h.
WHATSAPP_PUBLIC_URL=
WHATSAPP_SHARED_DIR=whatsapp_shared
# Web links pointing to localhost/private networks are refused; set true only for intranet use on a trusted setup.
ALLOW_PRIVATE_URLS=false
# Voice replies: off | voice (WhatsApp voice note, converted by OpenWA) | audio (plain audio file)
WHATSAPP_VOICE_REPLY=off
WHATSAPP_VOICE_REPLY_ONLY_TO_VOICE=true
WHATSAPP_TTS_LANGUAGE=auto
WHATSAPP_TTS_VOICE=
WHATSAPP_TTS_SPEED=1.0
# mcp = data tools over a real MCP stdio session (default); local = in-process
WHATSAPP_TOOL_TRANSPORT=mcp
WHATSAPP_HOST=0.0.0.0
WHATSAPP_PORT=8600
WHATSAPP_STATE_DB=whatsapp_state.db
WHATSAPP_FILES_DIR=whatsapp_files

# ---------- Files the app may read (security allowlist) ----------
# Local files / SQLite databases are only opened from: the project folder, the OS temp folder, WHATSAPP_FILES_DIR,
# the folders of WHATSAPP_DATA_FILES, and these extra roots (os.pathsep-separated).
DATA_DIR=
MCP_ALLOWED_FILE_ROOTS=

# ---------- Knowledge layer (optional hybrid RAG for PDFs / DOCX / TXT / SOPs / policies / website text) ----------
# OFF by default: the app behaves exactly as before. RAG is never used for sales/inventory/quantity totals — those always
# run through the data tools. When ON, document questions get only the top-k relevant chunks (with source/page) and
# citations; questions that mix data + documents ("September sales aur return policy ke according…") go to the agent.
RAG_ENABLED=false
RAG_TOP_K=5
# hash = built-in offline embeddings (no network) | openrouter = /embeddings API (spends credit) | sentence_transformers = local model
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_MODEL=
RAG_MIN_SCORE=0.12
RAG_CHUNK_CHARS=900
# sqlite file for the chunk index (default <DATA_DIR>/rag_index.db; empty = memory only)
RAG_INDEX_PATH=
# Workspace AI Instructions (Prompt Builder) are edited in the app: Settings → AI Instructions. No env needed.
